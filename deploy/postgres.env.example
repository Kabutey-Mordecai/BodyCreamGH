# =============================================================================
# deploy/postgres.env.example
#
# Credentials used ONLY to initialise the PostgreSQL container on first run.
# Copy this file to deploy/postgres.env and fill in real values.
#
# NEVER commit deploy/postgres.env — it is listed in .gitignore.
# Keep these values in sync with DB_NAME / DB_USER / DB_PASSWORD in backend/.env.
# =============================================================================

# DANGER: Use a strong, unique password (20+ random chars).
POSTGRES_DB=cosmetics_db
POSTGRES_USER=cosmetics_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
