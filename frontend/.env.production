# =============================================================================
# frontend/.env.production
#
# Vite reads this file automatically when you run `npm run build`.
# It is SAFE to commit because it contains no secrets — only the public API URL.
#
# On Netlify you can also set this in:
#   Site Settings → Environment Variables → VITE_API_URL
# =============================================================================

# The base URL for every API call from the frontend.
# Points to your DigitalOcean backend. No trailing slash.
VITE_API_URL=https://api.yourdomain.com/api
