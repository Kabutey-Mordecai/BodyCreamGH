# =============================================================================
# admin/.env.production
#
# Vite reads this file automatically when you run `npm run build`.
# Safe to commit — no secrets here, just the public API URL.
#
# On Netlify you can also set this in:
#   Site Settings → Environment Variables → VITE_API_URL
# =============================================================================

# The base URL for every API call from the admin dashboard.
# Same backend as the frontend — both hit the same API server.
VITE_API_URL=https://api.yourdomain.com/api
