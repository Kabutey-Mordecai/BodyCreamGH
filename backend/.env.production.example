# =============================================================================
# backend/.env.production.example
#
# Copy this file to .env on the production server and fill in every value.
# NEVER commit the real .env to GitHub — it contains secrets.
#
# Generate JWT_SECRET with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
# Number of trusted reverse-proxy hops in front of Node (1 for Nginx, 2 if a CDN sits in front).
# Must be a non-negative integer; never use "true".
TRUST_PROXY=1

# ── Database ──────────────────────────────────────────────────────────────────
# DANGER: DB_PASSWORD must be a strong, unique password (20+ random chars).
# The server refuses to start in production if it is missing or less than 8 chars.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cosmetics_db
DB_USER=cosmetics_user       # the non-superuser created by server-setup.sh
DB_PASSWORD=CHANGE_ME        # strong password, 20+ random chars

# ── JWT ───────────────────────────────────────────────────────────────────────
# DANGER: A weak or default JWT_SECRET lets anyone forge authentication tokens.
# Generate a strong secret with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Minimum 32 characters. The server refuses to start in production if it is
# missing, shorter than 32 chars, or matches a known placeholder.
JWT_SECRET=CHANGE_ME_64_CHAR_HEX_STRING
JWT_EXPIRE=15m
REFRESH_TOKEN_DAYS=7

# ── Admin MFA OTP HMAC secret ────────────────────────────────────────────────
# Independent 32+ char secret used to key HMAC-SHA256 digests of 6-digit admin OTPs.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
OTP_HMAC_SECRET=CHANGE_ME_OTP_HMAC_SECRET

# ── Paystack (live keys from dashboard.paystack.com → Settings → API Keys) ───
PAYSTACK_SECRET_KEY=sk_live_CHANGE_ME
PAYSTACK_PUBLIC_KEY=pk_live_CHANGE_ME

# ── Email (Transactional SMTP: Resend, AWS SES, Brevo, or Gmail) ─────────────
# Recommended for production: Resend (smtp.resend.com), AWS SES
# (email-smtp.<region>.amazonaws.com), or Brevo (smtp-relay.brevo.com).
# DNS required on your sending domain before going live:
#   - SPF TXT record authorizing your provider (e.g. include:amazonses.com / include:spf.brevo.com)
#   - DKIM CNAME/TXT records generated by your provider
#   - DMARC TXT record at _dmarc.yourdomain.com (start with v=DMARC1; p=none;)
# Always set EMAIL_FROM to a verified domain address when using SES/Resend/Brevo
# (since SMTP_USER is an API key or IAM username, not an email address).
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=resend
SMTP_PASS=CHANGE_ME_SMTP_API_KEY
EMAIL_FROM=BodyCream GH <orders@yourdomain.com>

# ── URLs ─────────────────────────────────────────────────────────────────────
# Used in password-reset email links and in the Paystack callback URL.
FRONTEND_URL=https://yourdomain.com

# Public base URL of this API server.
# Used to construct absolute URLs for uploaded product images in email templates
# and any external integrations. Relative paths are stored in the DB; this
# variable is only needed when a full URL must be built at response time.
BASE_URL=https://api.yourdomain.com

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API.
# Do not include a trailing slash.
ALLOWED_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com

# ── Admin bootstrap ───────────────────────────────────────────────────────────
# DANGER: ADMIN_PASSWORD must be a strong, unique password — not "mord123" or any
# dictionary word. Once the admin account is created you may remove these two
# lines from your .env (they are ignored if the account already exists).
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Logging ───────────────────────────────────────────────────────────────────
# "info" is the right level for production. Use "debug" only when troubleshooting.
LOG_LEVEL=info
