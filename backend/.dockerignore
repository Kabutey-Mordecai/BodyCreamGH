# Files excluded from the Docker build context.
# Keeping the context small speeds up builds and prevents secrets from leaking
# into intermediate layers.

node_modules/
npm-debug.log*

# Real .env — injected at runtime via --env-file or Compose environment:
.env
.env.*

# Logs written at runtime — not part of the image
logs/
*.log

# Uploaded product images — runtime data, never part of the image.
# Excluding them keeps the build context small and prevents local test uploads
# from being baked into an image that may be pushed to a registry.
# The .gitkeep placeholder is allowed so the directory skeleton is preserved.
uploads/products/*
!uploads/products/.gitkeep

# Development-only tools
.nyc_output/
coverage/

# Editor / OS noise
.DS_Store
Thumbs.db
.vscode/
.idea/
