# =============================================================================
# backend/.env.example — Local development & Docker environment template
# Copy to backend/.env and fill in your credentials. NEVER commit backend/.env.
# =============================================================================

PORT=5000
NODE_ENV=development
TRUST_PROXY=0

# ── Database (PostgreSQL 15+) ─────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cosmetics_db
DB_USER=postgres
DB_PASSWORD=mord123

# ── Authentication (Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=replace_with_a_64_char_random_hex_string_for_local_dev_only_123456
JWT_EXPIRE=15m
REFRESH_TOKEN_DAYS=7
OTP_HMAC_SECRET=replace_with_a_64_char_random_hex_string_for_admin_otp_only_123456

# ── Paystack (Ghana Mobile Money & Card) ──────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# ── Transactional Email (Brevo HTTPS API or SMTP) ─────────────────────────────
BREVO_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
EMAIL_FROM=BodyCream GH <orders@bodycreamgh.com>
EMAIL_REPLY_TO=support@bodycreamgh.com

# ── Local Ghana SMS Gateway (Arkesel, Hubtel, mNotify, or Brevo) ──────────────
# Leave SMS_PROVIDER empty to run in mock/log mode (or Brevo if BREVO_API_KEY is set).
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=BodyCreamGH
SMS_CLIENT_ID=
SMS_FALLBACK_PROVIDER=
SMS_FALLBACK_API_KEY=

# ── Media Storage (local disk fallback or Cloudflare R2 S3 API) ───────────────
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# ── Rate Limiting (CGNAT-safe defaults) ───────────────────────────────────────
LOGIN_IP_MAX=300
LOGIN_ACCT_MAX=60
REGISTER_IP_MAX=40
GLOBAL_IP_MAX=600

# ── Firebase Cloud Messaging (Mobile Push Notifications) ──────────────────────
# Leave empty to run in mock/log mode during local development.
FCM_SERVER_KEY=

# ── URLs & CORS ───────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BASE_URL=http://localhost:5000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://localhost:3001

# ── Initial Admin Bootstrap ───────────────────────────────────────────────────
ADMIN_EMAIL=admin@bodycreamgh.com
ADMIN_PASSWORD=ChangeMe123!

LOG_LEVEL=info
